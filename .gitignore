# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
dist/
.vite/
*.local

# App data (generated at runtime)
data/
*.db
*.db-journal

# Editors / OS
.claude/settings.local.json
*.tmp
.vscode/
.idea/
.DS_Store
Thumbs.db

# TS build cache
*.tsbuildinfo

# Static Pages build: only docs/index.html is tracked; everything else under
# docs/ is either build output or generated. (content-authoring-guide.md is a
# hand-written source doc and stays tracked.)
/docs/*
!/docs/index.html
!/docs/content-authoring-guide.md
